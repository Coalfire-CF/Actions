name: "CI: Markdown"

permissions:
  contents: write
  pull-requests: write

on:
  # No paths filter: the reusable workflow passes when no .md file changed, and a
  # filtered workflow never reports, which leaves a required check pending.
  pull_request:
    branches:
      - "**"
  workflow_call:

jobs:
  check-markdown:
    name: Check Markdown
    uses: Coalfire-CF/Actions/.github/workflows/ci-markdown.yml@__ACTIONS_SHA__ # __ACTIONS_VERSION__
